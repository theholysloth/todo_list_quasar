stages:
  - install
  - build
  - test

variables:
  NODE_ENV: production

install_front:
  stage: install
  image: node:20
  script:
    - npm install
  artifacts:
    paths:
      - node_modules/
    expire_in: 1h

build_front:
  stage: build
  image: node:20
  script:
    - npm install
    - npm run build
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
  needs:
    - install_front

test_front:
  stage: test
  image: node:20
  script:
    - npm install
    - npm run test
  needs:
    - install_front
