describe('Redirection si non connecté', () => {
  it('redirige vers /login', () => {
    cy.visit('/#/'); // ne pas s'arreter au 403 forbidden 

    cy.url().should('include', '/login');// gerer la redirection vers le login
    cy.contains('Connexion').should('exist'); // conexion est un texte de la page formulaire 
  });
});


describe('Page d’accueil', () => {
  beforeEach(() => {
    window.localStorage.setItem('token', 'fake-token');
  });

  it('charge correctement quand on est connecté', () => {
    cy.visit('/');
    cy.contains('Quasar').should('exist');
  });
});

describe('Formulaire de connexion', () => {
  beforeEach(() => {
    cy.visit('/#/login');
  });

  it('affiche email et mot de passe', () => {
    cy.get('input[type="email"]').should('exist');
    cy.get('input[type="password"]').should('exist');
  });

  it('affiche une erreur si les champs sont vides', () => {
    cy.contains('.q-btn', 'Se connecter').click();

    cy.contains('Email requis').should('exist');
    cy.contains('Mot de passe requis').should('exist');
  });

  it('refus mauvais login', () => {
    cy.get('input[type="email"]').type('fake@test.com');
    cy.get('input[type="password"]').type('wrongpass');
    cy.contains('.q-btn', 'Se connecter').click();

    cy.contains('Identifiants incorrects').should('exist');
  });

  it('accepte login et redirige', () => {
    cy.get('input[type="email"]').type('superadmin@example.com');
    cy.get('input[type="password"]').type('superadmin123');
    cy.contains('.q-btn', 'Se connecter').click();

    cy.url().should('include', '/#/list');
    //cy.contains('taches').should('exist'); 

  });
});


describe('Inscription', () => {
  beforeEach(() => {
    cy.visit('/#/register')
  })

  it('affiche tous les champs', () => {
    cy.contains('Inscription').should('exist')

    cy.contains('Nom').should('exist')
    cy.contains('Email').should('exist')
    cy.contains('Mot de passe').should('exist')
    cy.contains('Confirmation du mot de passe').should('exist')
  })

  it('inscription reussie', () => {
    cy.get('.q-input input').eq(0).type('Test')              
    cy.get('.q-input input').eq(1).type('blabla@example.com')       
    cy.get('.q-input input').eq(2).type('password123')             
    cy.get('.q-input input').eq(3).type('password123')

    cy.contains('.q-btn', 'Créer le compte').click()
    cy.url().should('include', '/#/list');
    //cy.contains('confirmation').should('exist') // message Laravel
  })

  
})
