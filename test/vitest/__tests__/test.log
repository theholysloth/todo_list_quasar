docker compose 
version: '3.9'

services:
  quasar: 
    image: node:latest
    working_dir: /app
    ports:
      - "9000:9000"
    volumes:
      - ./todoList2:/app
    tty : true
    stdin_open: true
    command: sh -c "npm install && npx quasar dev -H 0.0.0.0 -p 9000"
    environment:
      - CHOKIDAR_USEPOLLING=true
      - CHOKIDAR_INTERVAL=500
      - WATCHPACK_POLLING=true
      - WDS_SOCKET_PORT=8080
  
  cypress:
    image: cypress/included:15.13.1
    container_name: cypress-tests
    working_dir: /e2e
    volumes:
      - ./todoList2:/e2e
    depends_on:
      - quasar
    environment:
      - CYPRESS_baseUrl=http://quasar:9000
    entrypoint: ""
    command: sh -c "npx wait-on http://quasar:9000 && cypress run"

